# Where the FastAPI backend lives.
#
# This value is baked into the browser bundle at build time, so it must be a
# plain public URL — never put a secret here. Every credential (OpenAI, Infobip)
# stays on the backend; the browser only ever calls the public REST endpoints
# and the /ws/events socket.
#
# Leave this unset for local development: the app falls back to
# http://localhost:8000, which is where `uvicorn app:app` serves the backend.
#
# You can also override it per-visit with ?api=https://... which is handy for
# pointing a local page at a deployed backend while testing.

VITE_API_URL=https://university-calling-agent.onrender.com
