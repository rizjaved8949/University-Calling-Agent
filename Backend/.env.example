# =============================================================================
# University Voice Agent — backend configuration
# Copy to .env and fill in. Never commit .env.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development                  # development | production
HOST=0.0.0.0
PORT=8000                            # Render overrides this with $PORT
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# --- Frontend / CORS ---------------------------------------------------------
# Comma-separated list of allowed origins. Set this to your Vercel URL in prod.
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Knowledge base / RAG ----------------------------------------------------
KNOWLEDGE_BASE_PDF=Knowledge_Base.pdf
# BAAI/bge-small-en-v1.5 is 67MB and runs on ONNX — fits Render's free tier.
# For Urdu-script queries use sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (220MB).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=1100                      # characters per chunk
CHUNK_OVERLAP=180
TOP_K=5                              # how many chunks to retrieve
# Cap on how many chunks one section may contribute, so a single long
# section cannot fill the whole context and crowd out the others.
MAX_CHUNKS_PER_SECTION=3
SIMILARITY_THRESHOLD=0.60            # 0-1, raise for stricter matching
RAG_MAX_CONTEXT_CHARS=4000
CACHE_ENABLED=true                   # reuse embeddings between restarts
CACHE_DIR=.cache

# --- LLM (text chat endpoint) ------------------------------------------------
LLM_MODEL=gpt-4o                     # gpt-4o-mini is cheaper but mangles lakh conversions
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=600
LLM_REASONING_EFFORT=low             # only used by gpt-5.x / o-series models

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...
# Project id — this is also the SIP user the telephony trunk must target.
OPENAI_PROJECT_ID=proj_...
# Settings > Project > Webhooks, subscribed to realtime.call.incoming
OPENAI_WEBHOOK_SECRET=whsec_...
OPENAI_SIP_DOMAIN=sip.api.openai.com

# --- Voice agent -------------------------------------------------------------
REALTIME_MODEL=gpt-realtime-2.1      # the -mini tier paraphrases the greeting and sounds robotic
TTS_VOICE=marin                      # marin/cedar are current; the rest sound synthetic on a phone
# Playback rate, 0.25-1.5. Under 1.0 stops the narrowband codec clipping long
# Urdu vowels. Raise to 1.0 if she ever sounds slow. Sent only when not 1.0.
TTS_SPEED=0.95
LANGUAGE=ur-PK
STT_MODEL=gpt-4o-transcribe          # blank disables live transcripts; -mini drops code-mixed words
TURN_DETECTION=semantic_vad          # semantic_vad ends a turn on meaning, not a silence timer
# semantic_vad only. How readily she decides the caller has finished.
# 'high' is the quick end; move to 'medium' if she starts answering before
# hesitant callers have finished their sentence. 'auto' leaves it to the API.
VAD_EAGERNESS=high                   # low | medium | high | auto
VAD_THRESHOLD=0.68                   # raise if noise triggers it; lower if she misses soft speech
VAD_PREFIX_PADDING_MS=300
VAD_SILENCE_MS=700
INTERRUPTION_ENABLED=true            # caller can talk over the agent (barge-in)
NOISE_REDUCTION=near_field           # near_field | far_field | none

# --- Call behaviour ----------------------------------------------------------
MAX_CALL_DURATION_SECONDS=60000       # 100 minutes. 300 = 5 minutes.
CALL_CONNECT_TIMEOUT_SECONDS=45
# How long before the hard limit she starts closing the conversation, so
# the carrier does not cut the caller off mid-sentence.
WRAP_UP_WARNING_SECONDS=30
# How long to let the farewell play out before dropping the line. The model
# finishes generating well before the carrier finishes playing, so hanging up
# the instant a response completes clips "Allah Hafiz" in half.
HANGUP_GRACE_SECONDS=3.5
# Silence held before the greeting starts. The realtime socket is ready
# before the SIP media path actually carries audio, so speaking the instant
# it opens throws the first syllable away. Raise if the opening is still
# clipped, lower if the line feels dead on pickup.
GREETING_DELAY_SECONDS=0.35
# Attach the AI leg while the phone is still ringing instead of waiting for
# pickup, removing the SIP setup from the silence after the caller answers.
# Off by default: it opens a realtime session during the ring, which OpenAI
# bills for even on calls nobody picks up. She still never speaks before the
# legs are bridged.
PREDIAL_AGENT_LEG=true
AGENT_GREETING=Assalam-o-Alaikum! University Call Center se Ayesha baat kar rahi hoon. Aap ki kis silsilay mein madad kar sakti hoon?

# --- Telephony (Infobip) -----------------------------------------------------
TELEPHONY_PROVIDER=infobip
INFOBIP_BASE_URL=xxxxx.api-xxx.infobip.com
INFOBIP_API_KEY=                     # needs Calls API scopes
INFOBIP_PHONE_NUMBER=+920000000000
INFOBIP_SIP_TRUNK_ID=                # the trunk's id, not its name
INFOBIP_CALLS_CONFIGURATION_ID=      # must have a VOICE_VIDEO subscription
INFOBIP_APPLICATION_ID=              # optional; narrows subscription matching

# --- WhatsApp (Meta Cloud API, direct — not through Infobip) -----------------
# Sending needs ACCESS_TOKEN + PHONE_NUMBER_ID + TEMPLATE. While TEMPLATE is
# blank the feature is off and Ayesha is told she cannot send messages.
#
# The template must be approved by Meta and take exactly ONE body placeholder
# (the token). See WHATSAPP_TEMPLATE.md.
#
# Keep comments on their own lines. An inline "# ..." after the = is read as
# part of the value.
# META_APP_ID / META_APP_SECRET / WHATSAPP_WEBHOOK_VERIFY_TOKEN are NOT read
# by the backend. Sending uses WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID
# only, and there is no inbound WhatsApp webhook to verify. Kept blank so the
# file matches what Meta's dashboard shows you; delete them if you prefer.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_PHONE_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=en
WHATSAPP_COUNTRY_CODE=92

# --- Manual calls (a person talks, the agent stays out) ----------------------
# Pre-fills "your number" in the Talk tab. Optional.
OPERATOR_PHONE_NUMBER=
# Browser-microphone calling needs NO application id — leave this blank. What it
# does need is the `webrtc:manage` scope on the Infobip API key (Developer Tools
# -> API Keys -> the key -> search "webrtc"). Without it /webrtc/1/token returns
# UNAUTHORIZED. Set this only for application calls or mobile push, neither of
# which the Talk tab uses.
INFOBIP_WEBRTC_APPLICATION_ID=
# How long a browser calling token stays valid. Short by design - it is
# handed to the browser, and a fresh one costs one request.
RTC_TOKEN_TTL_SECONDS=600

# --- Recording ---------------------------------------------------------------
RECORD_CALLS=true
RECORDING_TYPE=AUDIO                 # AUDIO | AUDIO_AND_VIDEO
RECORDING_FILE_PREFIX=ucp-voice
# How long to wait for the carrier's media socket to drain before encoding. The
# call-ended webhook arrives before the last audio frames do, and encoding
# straight away cuts the end off every recording.
RECORDING_TAIL_WAIT_SECONDS=6
# Record from the carrier's live media stream rather than asking for their
# finished recording - their composed files arrived short and one-sided.
# Needs PUBLIC_BASE_URL to be reachable over wss://, since the carrier
# connects back to it.
RECORD_FROM_MEDIA_STREAM=true
MEDIA_STREAM_CONFIG_NAME=ucp-voice-recorder
# Record Talk-tab calls in the browser. Infobip does not record WebRTC
# calls, so turning this off means those calls have no audio at all.
RECORD_BROWSER_CLIENT_SIDE=true
# Ceiling on a recording the browser posts up. Opus at conversational
# bitrates is roughly 200KB a minute, so this is hours of call; it is here
# to stop an unauthenticated endpoint being handed a film. Bytes.
MAX_UPLOAD_BYTES=41943040           # 40 MB
# Re-encode provider recordings to MP3 on the way in. Carrier WAV is eight
# times the size for no audible gain on a phone call, and those bytes are
# the wait before playback starts.
TRANSCODE_RECORDINGS=true
# Only so a wedged ffmpeg cannot hold a web request open. Speech re-encodes
# far faster than real time.
TRANSCODE_TIMEOUT_SECONDS=120
# Mix Ayesha's half in from the realtime socket, for when the carrier's stream
# comes back with only the caller on it. Turn on for one call, then check the
# log line "call <id>: carrier Ns, agent track Ns" — the two durations should be
# close. If the agent track reads half the call, halve the rate below; if it
# reads double, double it. A wrong rate makes her sound like a chipmunk.
RECORD_AGENT_AUDIO=false
AGENT_AUDIO_SAMPLE_RATE=24000        # OpenAI realtime PCM16 default

# --- Reconciliation with the provider -----------------------------------------
# Webhooks are not guaranteed to arrive; these control how often the service
# asks the provider what actually happened instead. A lower interval means a
# call whose finish event was lost closes sooner. The window is how long after
# a call ends to keep chasing its recording — composition is not instant, and a
# wide window also recovers calls that ended while the service was asleep.
RECONCILE_INTERVAL_SECONDS=20
RECONCILE_WINDOW_SECONDS=3600
# The same check while a call is actually up, where the delay shows as a
# dashboard timer still running after the student has hung up.
LIVE_POLL_SECONDS=5
# How long after a call ends to keep believing a recording might still be
# coming. Past this, with the provider reporting nothing, the dashboard says
# so instead of offering a retry that cannot succeed.
RECORDING_GRACE_SECONDS=180

# --- Storage -----------------------------------------------------------------
# SQLite by default. Render's free filesystem is ephemeral, so call logs reset
# on redeploy — attach a disk or point this at a managed database to persist.
DATABASE_PATH=data/calls.db
# Where downloaded call audio is kept. Put this on the same persistent disk as
# the database in production; inside the container it is lost on every deploy.
RECORDINGS_DIR=data/recordings

# --- Supabase (durable call log + recordings) ---------------------------------
# Set all four and the two settings above stop being used: the call log moves to
# Postgres and the audio to Supabase Storage, so a redeploy loses neither. Leave
# them blank on a dev machine to keep using SQLite and the local disk.
#
# DATABASE_URL must be the SESSION POOLER uri, port 5432 - Supabase's direct
# connection is IPv6-only and most hosts cannot reach it. Percent-encode any
# special characters in the password.
DATABASE_URL=
# Project URL, e.g. https://abcdefghijk.supabase.co
SUPABASE_URL=
# The project's "secret" key (formerly service_role). It bypasses row level
# security, so it is server-side only - it must never reach a browser. Note it
# authenticates through the `apikey` header, not `Authorization: Bearer`.
SUPABASE_SERVICE_KEY=
# Create this bucket yourself and leave it PRIVATE: audio is served through
# /api/calls/{id}/recording, never by a public link.
SUPABASE_BUCKET=call-recordings
# Free-plan buckets reject anything larger. A call over the limit is not
# lost: the provider's file id is kept and the audio streamed from them on
# demand instead. ~50 MB is about 50 minutes of 8kHz WAV. Bytes.
SUPABASE_MAX_UPLOAD_BYTES=52428800  # 50 MB

# --- Public URL --------------------------------------------------------------
# HTTPS origin both providers post webhooks to (your Render URL, or a tunnel).
PUBLIC_BASE_URL=https://your-service.onrender.com

# --- Post-call record + Excel report ------------------------------------------
# What was said on each call, stored so the summary and the report can be built
# from it. Off leaves the recording as the only record of a call.
TRANSCRIPT_STORE_ENABLED=true
# Summarise every call when it ends: purpose, questions, what was answered, what
# was not, and the student details the caller actually gave. Nothing is invented
# - a fact the caller never stated stays empty.
SUMMARY_ENABLED=true
# Blank means "the same model as LLM_MODEL".
SUMMARY_MODEL=
# The name the browser saves the master workbook under. One file for every call
# ever taken - see GET /api/exports/calls.xlsx.
EXCEL_FILENAME=Voice_Agent_Call_Records.xlsx

# --- Interruptions -----------------------------------------------------------
# After the caller cuts in, their question is answered first and alone. With
# this on, the agent may then offer the part it was cut off saying - once, in a
# later turn, and only when missing it would cost the caller something.
RESUME_OFFER_ENABLED=true
# Below this many characters a cut-off turn is not worth returning to: it was
# a greeting, an acknowledgement, or half a word.
RESUME_OFFER_MIN_CHARS=60

# --- WhatsApp: sending the details themselves --------------------------------
# The SECOND template (see WHATSAPP_TEMPLATE.md). WHATSAPP_TEMPLATE above sends
# a reference number; this one sends the actual information - either a written
# copy of what Ayesha said on the call, or the department's answer when a query
# is resolved in the dashboard.
#
# Leave blank until Meta has APPROVED the template. While it is blank the agent
# is not offered the tool at all, so she cannot promise a message that will
# never arrive.
WHATSAPP_DETAILS_TEMPLATE=
# Caps on the two blanks in that template. The rendered body may not exceed
# 1024 characters and the fixed wording takes ~200, so these leave headroom.
WHATSAPP_TOPIC_MAX_CHARS=120
WHATSAPP_DETAILS_MAX_CHARS=600

# --- Inbound WhatsApp (student replies, Ayesha answers) ----------------------
# When a student replies to one of our messages, their reply opens Metas
# 24-hour customer service window - and inside it we may answer in FREE-FORM
# text, with no template and no approval. That is what makes the WhatsApp side
# conversational rather than one-way.
#
# Needs the messages webhook field subscribed in Meta > WhatsApp >
# Configuration, with the callback URL PUBLIC_BASE_URL + /webhooks/whatsapp
WHATSAPP_INBOUND_ENABLED=true
